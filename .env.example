# ============================================================
# Database (Neon Postgres)
# ============================================================

# DATABASE_URL is the pooled connection (runtime queries); DIRECT_URL
# is the same database via the unpooled host (strip "-pooler" from the
# hostname) — Prisma Migrate needs a direct connection since the
# pooler doesn't support prepared statements.
DATABASE_URL=
DIRECT_URL=

# ============================================================
# AI image generation
# ============================================================

# Merchants configure their own AI provider and API key from the app's
# Settings page (Style > AI provider settings) — the app never supplies
# its own OpenAI/Google credentials. Nothing to set here for that.

# Required. Encrypts merchant-supplied AI provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Optional. If omitted, SHOPIFY_API_SECRET is used for signing
# temporary generated-image URLs.
MEDIA_SIGNING_SECRET=

# ============================================================
# Shopify app credentials
# ============================================================

# `shopify app dev` injects these automatically at runtime — you don't
# need them for normal dev work. They're only required to run a
# one-off script directly (e.g. `npx tsx some-script.ts`) that imports
# anything touching app/shopify.server.ts outside the CLI-wrapped
# process; without them, that import throws immediately.
# Values come from shopify.app.toml / Partner Dashboard > App setup.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# gid://shopify/App/{numeric app id}. Used both as a Partner API query
# variable and read directly by billing.server.ts.
SHOPIFY_APP_GID=

# The app's handle (Partner Dashboard > Basic app information /
# shopify.app.toml's `handle` field). Required to build the
# Shopify-hosted pricing page URL under Shopify App Pricing — see
# app/services/billing/shopify-pricing.server.ts.
SHOPIFY_APP_HANDLE=

# ============================================================
# Shopify Partner API
# ============================================================

# Primary source of truth for Pro-plan status (see isShopOnProPlan in
# app/services/billing/billing.server.ts) — Shopify App Pricing
# subscriptions are created via Shopify's own hosted pricing page, not
# through this app's Admin API session, so the Partner API's
# activeSubscription() is the reliable way to read a shop's plan. If
# left blank, the app falls back to the (less reliable, for Shopify App
# Pricing) Admin API subscription check instead.
# Same organization ID and access token work across every app in this
# Partner account — get them from Partner Dashboard > Settings > API
# clients (create a Partner API client if none exists yet); the
# organization ID is also in your partners.shopify.com URL.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
