// AI Art Studio database schema.
//
// Shopify owns commerce:
// products, variants, collections, checkout, payments and orders.
//
// AI Art Studio owns:
// styles, prompts, customer input definitions, generation jobs,
// generated assets and Shopify product linkage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StyleStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  PUBLISH_ERROR
  UNPUBLISHING
  UNPUBLISHED
}

enum StyleFieldType {
  IMAGE
  TEXT
  TEXTAREA
  SELECT
  TOGGLE
  NUMBER
  DATE
}

enum StyleAssetKind {
  REFERENCE
  PRODUCT_GENERATED
  PRODUCT_SELECTED
  CUSTOMER_UPLOAD
  CUSTOMER_RESULT
  FRAME_TEXTURE
}

enum StyleOptionType {
  TEXT
  COLOR_SWATCH
}

enum StyleOptionAxisRole {
  SIZE
  FRAMING
}

// How a choice's own attached image (StyleOptionChoice.imageAssetId)
// renders as a storefront swatch — purely presentational, set once per
// option (not per choice) so every choice under it stays visually
// consistent. Meaningless when no choice under the option has an
// image at all.
enum StyleOptionImageOrientation {
  HORIZONTAL
  VERTICAL
}

// FILL crops the image to completely cover the swatch shape (like CSS
// object-fit: cover); ORIGINAL shows the whole image uncropped,
// possibly with empty space around it (like object-fit: contain).
enum StyleOptionImageFit {
  FILL
  ORIGINAL
}

enum GenerationPurpose {
  STYLE_PRODUCT
  CUSTOMER_PREVIEW
  CUSTOMER_FINAL
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Style {
  id     String      @id @default(cuid())
  shop   String
  name   String
  status StyleStatus @default(DRAFT)

  // AI transformation configuration.
  prompt             String  @default("")
  provider           String  @default("openai")
  model              String?
  outputAspectRatio  String  @default("1:1")
  outputQuality      String  @default("high")
  previewCount       Int     @default(1)
  generationSettings Json

  // Shopify product draft configuration.
  productTitle       String
  productDescription String   @default("")
  basePrice          Decimal  @default(0)
  compareAtPrice     Decimal?
  tags               Json
  collectionIds      Json
  productSettings    Json

  // Populated only after Shopify product creation succeeds.
  shopifyProductId     String?   @unique
  shopifyProductHandle String?
  publishedAt          DateTime?
  publishError         String?

  // Storefront swatch styling — global to the whole Style (applies to
  // every Product option's choice swatches uniformly), not settable
  // per option. Optional pixel overrides of the storefront's own
  // built-in defaults; the *MobilePx twins only take effect below the
  // storefront's mobile breakpoint and fall back to the desktop value
  // (not straight to the built-in default) when left unset — same
  // convention as every other optional px override in this schema.
  swatchWidthPx          Int?
  swatchHeightPx         Int?
  swatchFontSizePx       Int?
  swatchWidthMobilePx    Int?
  swatchHeightMobilePx   Int?
  swatchFontSizeMobilePx Int?

  // Chip spacing/border — same "global to the whole Style" scope as
  // the sizing fields above. swatchGapPx is the gap between adjacent
  // choice chips within one option's row. swatchFullBleed, when true,
  // makes an image-bearing choice's photo fill its entire chip edge-
  // to-edge (covering the chip's own border) with the label/price
  // overlaid on top, instead of sitting as a small inset thumbnail
  // above them — meaningless for a choice with no image.
  swatchGapPx                 Int?
  swatchBorderColor           String?
  swatchActiveBorderColor     String?
  swatchRadiusPx              Int?
  swatchBackgroundColor       String?
  swatchActiveBackgroundColor String?
  swatchFullBleed             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      StyleField[]
  assets      StyleAsset[]
  generations Generation[]
  options     StyleOption[]

  @@index([shop, status])
  @@index([shop, createdAt])
}

model StyleField {
  id           String         @id @default(cuid())
  styleId      String
  key          String
  label        String
  type         StyleFieldType
  required     Boolean        @default(false)
  position     Int            @default(0)
  placeholder  String?
  helpText     String?
  defaultValue String?
  options      Json?
  config       Json?

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([styleId, key])
  @@index([styleId, position])
}

model StyleAsset {
  id           String         @id @default(cuid())
  styleId      String
  generationId String?
  kind         StyleAssetKind
  storageKey   String?
  url          String?
  mimeType     String?
  width        Int?
  height       Int?
  altText      String?
  position     Int            @default(0)

  // M4 stores merchant-generated product examples here.
  // Customer production assets will move to object storage.
  binaryData Bytes?

  // Set once this asset has been attached to the Shopify product's media
  // gallery by the Publish engine. Lets a retried publish reuse the
  // existing Shopify media instead of re-uploading and duplicating it.
  shopifyMediaId String?

  style      Style       @relation(fields: [styleId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  // Back-relation only — a FRAME_TEXTURE-kind asset referenced by a
  // StyleOptionChoice's own imageAssetId FK.
  optionChoices StyleOptionChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([styleId, kind])
  @@index([generationId])
}

model Generation {
  id      String            @id @default(cuid())
  shop    String
  styleId String
  purpose GenerationPurpose
  status  GenerationStatus  @default(QUEUED)

  provider          String
  model             String?
  prompt            String
  providerRequestId String?

  inputPayload  Json?
  outputPayload Json?
  usage         Json?
  costMicros    BigInt?

  attempt      Int       @default(1)
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  style  Style        @relation(fields: [styleId], references: [id], onDelete: Cascade)
  assets StyleAsset[]

  @@index([shop, createdAt])
  @@index([styleId, status])
}

// Per-shop bring-your-own-key AI provider configuration. The app never
// supplies its own AI provider credentials to merchants — each shop
// configures its own provider, model, and API key here. apiKeySecret is
// encrypted at rest (see app/services/security/secret-box.server.ts);
// apiKeyLastFour is a display-only hint and is never enough to
// reconstruct the key.
model ShopAIProviderSettings {
  id String @id @default(cuid())

  shop String @unique

  provider String
  model    String

  apiKeySecret   String
  apiKeyLastFour String

  // Reserved for provider-specific extras (e.g. a region or project
  // field some future provider might require). Neither current
  // provider (OpenAI, Google) needs anything beyond the API key.
  // Defaulted in application code, not at the DB level (SQLite can't
  // express a JSON literal default).
  extraConfig Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shop-wide defaults for generated image output, applied to every new
// Style at creation time (Styles no longer expose these per-style — one
// place to set them, per merchant request). A Style keeps its own copy
// of the values it was created with, so changing the shop default later
// does not retroactively change already-created styles.
model ShopGenerationDefaults {
  id String @id @default(cuid())

  shop String @unique

  outputAspectRatio String @default("1:1")
  outputQuality     String @default("high")
  previewCount      Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Generalized, merchant-configurable product option — edited on its
// own "Product options" tab. Replaces what used to be three hardcoded
// concepts (Sizes, Framing, Mat colors) with one flexible system.
// Never modeled as a real Shopify product option/variant — every
// option's pricing (if any) is applied at checkout by the
// ai-art-generator-price-transform Cart Transform Function instead
// (see style-pricing-sync.server.ts). Any option's choices may
// optionally carry a price (StyleOptionChoice.priceDelta) — there is
// no longer a role distinguishing "priced" from "free" options; a
// merchant just leaves priceDelta blank on a choice that shouldn't
// affect price.
//
// - axisRole is optional, and at most one option per style may hold
//   each value: SIZE marks the one axis whose choices carry
//   scalePercent (drives image-resolution scaling at serve time — see
//   media.style-assets.$assetId.ts) and must keep at least one choice
//   at 100%; its priceDelta is each size's own absolute price, not a
//   delta. FRAMING marks the one axis whose choices may carry
//   requiresShipping/a visual frame (color and/or uploaded image) —
//   the only axis that can make an order require physical shipping.
//   Every other option (axisRole null) — including one with priced
//   choices — is just a plain add-on, e.g. Mat color.
// - type controls whether a choice's hexColor is editable: TEXT
//   (plain labeled buttons) or COLOR_SWATCH (also has a color).
//   Independent of type, every choice may also optionally have its
//   own uploaded image (StyleOptionChoice.imageAssetId) — not a
//   separate type, just an optional attachment any choice can carry.
//   imageOrientation/imageFit control how that image renders as a
//   swatch — set once per option (not per choice), and meaningless
//   unless at least one choice actually has an image. Swatch box size
//   and label font size are NOT set here — they're a Style-wide
//   design setting (see Style's own swatchWidthPx and friends),
//   applying uniformly to every option on the Style.
model StyleOption {
  id String @id @default(cuid())

  styleId String

  label            String
  type             StyleOptionType
  axisRole         StyleOptionAxisRole?
  imageOrientation StyleOptionImageOrientation @default(HORIZONTAL)
  imageFit         StyleOptionImageFit         @default(FILL)

  position Int @default(0)

  style   Style               @relation(fields: [styleId], references: [id], onDelete: Cascade)
  choices StyleOptionChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // At most one StyleOption per style may have axisRole SIZE, and at
  // most one may have axisRole FRAMING — enforced in application code
  // (style-options.server.ts), since Postgres partial-unique indexes
  // aren't expressible in Prisma's schema DSL.

  @@unique([styleId, label])
  @@index([styleId, position])
}

// One selectable value under a StyleOption. Which fields are
// meaningful depends entirely on the parent option's type/axisRole
// (see StyleOption's own comment) — e.g. hexColor only when the
// parent's type is COLOR_SWATCH. imageAssetId is always optional and
// available on every choice regardless of type — a plain thumbnail
// (e.g. a Size choice's own reference photo) everywhere except the
// one axisRole FRAMING option, where it doubles as an uploaded frame
// texture (rendered via CSS border-image) and pairs with
// borderThicknessPx. priceDelta is always optional (null = this
// choice never affects price) except on the one axisRole SIZE option,
// where it's required and holds that size's own absolute price rather
// than a delta. id is what the Cart Transform Function's pricing
// config keys selections against (see style-pricing-sync.server.ts),
// so renaming a choice's label later doesn't lose track of its price.
model StyleOptionChoice {
  id String @id @default(cuid())

  optionId String

  label               String
  priceDelta          Decimal?
  compareAtPriceDelta Decimal?
  requiresShipping    Boolean  @default(false)
  scalePercent        Int?
  hexColor            String?
  imageAssetId        String?
  // The three below are meaningful only for a choice under the one
  // axisRole FRAMING option. All optional — null falls back to the
  // storefront CSS's own defaults, so setting these is opt-in per
  // choice, not required.
  borderThicknessPx   Int?
  matThicknessPx      Int?
  borderRadiusPx      Int?
  position            Int      @default(0)

  option     StyleOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  imageAsset StyleAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionId, label])
  @@index([optionId, position])
  @@index([imageAssetId])
}

// Shopify's standard offline/online session model remains independent from
// merchant-created AI styles. No Shopify product is created when a Style
// record is created. Product creation happens only during Publish.
