// AI Art Studio database schema.
//
// Shopify owns commerce:
// products, variants, collections, checkout, payments and orders.
//
// AI Art Studio owns:
// styles, prompts, customer input definitions, generation jobs,
// generated assets and Shopify product linkage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StyleStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  PUBLISH_ERROR
  UNPUBLISHING
  UNPUBLISHED
}

enum StyleFieldType {
  IMAGE
  TEXT
  TEXTAREA
  SELECT
  TOGGLE
  NUMBER
  DATE
}

enum StyleAssetKind {
  REFERENCE
  PRODUCT_GENERATED
  PRODUCT_SELECTED
  CUSTOMER_UPLOAD
  CUSTOMER_RESULT
  FRAME_TEXTURE
}

enum StyleOptionType {
  TEXT
  COLOR_SWATCH
  IMAGE_SWATCH
}

enum StyleOptionRole {
  VARIANT
  EXTRA
}

enum StyleOptionAxisRole {
  SIZE
  FRAMING
}

enum GenerationPurpose {
  STYLE_PRODUCT
  CUSTOMER_PREVIEW
  CUSTOMER_FINAL
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Style {
  id     String      @id @default(cuid())
  shop   String
  name   String
  status StyleStatus @default(DRAFT)

  // AI transformation configuration.
  prompt             String  @default("")
  provider           String  @default("openai")
  model              String?
  outputAspectRatio  String  @default("1:1")
  outputQuality      String  @default("high")
  previewCount       Int     @default(1)
  generationSettings Json

  // Shopify product draft configuration.
  productTitle       String
  productDescription String  @default("")
  basePrice          Decimal @default(0)
  compareAtPrice     Decimal?
  tags               Json
  collectionIds      Json
  productSettings    Json

  // Populated only after Shopify product creation succeeds.
  shopifyProductId     String?   @unique
  shopifyProductHandle String?
  publishedAt          DateTime?
  publishError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      StyleField[]
  assets      StyleAsset[]
  generations Generation[]
  options     StyleOption[]

  @@index([shop, status])
  @@index([shop, createdAt])
}

model StyleField {
  id           String         @id @default(cuid())
  styleId      String
  key          String
  label        String
  type         StyleFieldType
  required     Boolean        @default(false)
  position     Int            @default(0)
  placeholder  String?
  helpText     String?
  defaultValue String?
  options      Json?
  config       Json?

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([styleId, key])
  @@index([styleId, position])
}

model StyleAsset {
  id           String         @id @default(cuid())
  styleId      String
  generationId String?
  kind         StyleAssetKind
  storageKey   String?
  url          String?
  mimeType     String?
  width        Int?
  height       Int?
  altText      String?
  position     Int            @default(0)

  // M4 stores merchant-generated product examples here.
  // Customer production assets will move to object storage.
  binaryData Bytes?

  // Set once this asset has been attached to the Shopify product's media
  // gallery by the Publish engine. Lets a retried publish reuse the
  // existing Shopify media instead of re-uploading and duplicating it.
  shopifyMediaId String?

  style      Style       @relation(fields: [styleId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  // Back-relation only — a FRAME_TEXTURE-kind asset referenced by a
  // StyleOptionChoice's own frameImageAssetId FK.
  framingChoices StyleOptionChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([styleId, kind])
  @@index([generationId])
}

model Generation {
  id      String            @id @default(cuid())
  shop    String
  styleId String
  purpose GenerationPurpose
  status  GenerationStatus  @default(QUEUED)

  provider          String
  model             String?
  prompt            String
  providerRequestId String?

  inputPayload  Json?
  outputPayload Json?
  usage         Json?
  costMicros    BigInt?

  attempt      Int       @default(1)
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  style  Style        @relation(fields: [styleId], references: [id], onDelete: Cascade)
  assets StyleAsset[]

  @@index([shop, createdAt])
  @@index([styleId, status])
}

// Per-shop bring-your-own-key AI provider configuration. The app never
// supplies its own AI provider credentials to merchants — each shop
// configures its own provider, model, and API key here. apiKeySecret is
// encrypted at rest (see app/services/security/secret-box.server.ts);
// apiKeyLastFour is a display-only hint and is never enough to
// reconstruct the key.
model ShopAIProviderSettings {
  id String @id @default(cuid())

  shop String @unique

  provider String
  model    String

  apiKeySecret   String
  apiKeyLastFour String

  // Reserved for provider-specific extras (e.g. a region or project
  // field some future provider might require). Neither current
  // provider (OpenAI, Google) needs anything beyond the API key.
  // Defaulted in application code, not at the DB level (SQLite can't
  // express a JSON literal default).
  extraConfig Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Shop-wide defaults for generated image output, applied to every new
// Style at creation time (Styles no longer expose these per-style — one
// place to set them, per merchant request). A Style keeps its own copy
// of the values it was created with, so changing the shop default later
// does not retroactively change already-created styles.
model ShopGenerationDefaults {
  id String @id @default(cuid())

  shop String @unique

  outputAspectRatio String @default("1:1")
  outputQuality     String @default("high")
  previewCount      Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Generalized, merchant-configurable product option — edited on its
// own "Product options" tab. Replaces what used to be three hardcoded
// concepts (Sizes, Framing, Mat colors) with one flexible system:
//
// - role: VARIANT choices become real Shopify variants at publish
//   time (priced, via style-publish.server.ts's cartesian-product
//   logic — this app deliberately keeps using native Shopify variants
//   for pricing rather than an app-managed cart-transform mechanism).
//   role: EXTRA choices never touch Shopify — purely visual/app-owned,
//   price-neutral, independent of whichever variant is selected (e.g.
//   Mat color).
// - axisRole is meaningful only for role: VARIANT options, and at
//   most one option per style may hold each value: SIZE marks the one
//   axis whose choices carry scalePercent (drives image-resolution
//   scaling at serve time — see media.style-assets.$assetId.ts) and
//   must keep at least one choice at 100%; FRAMING marks the one axis
//   whose choices may carry requiresShipping/a visual frame (color or
//   uploaded image) — the only axis that can make a variant a real
//   physical product. A style can still add further plain VARIANT
//   axes (axisRole null) — just price, no special meaning — beyond
//   these two.
// - type controls how a choice is edited/rendered: TEXT (plain
//   labeled buttons), COLOR_SWATCH (hex color), IMAGE_SWATCH
//   (merchant-uploaded texture, rendered via CSS border-image).
model StyleOption {
  id String @id @default(cuid())

  styleId String

  label    String
  type     StyleOptionType
  role     StyleOptionRole
  axisRole StyleOptionAxisRole?
  position Int                  @default(0)

  style   Style               @relation(fields: [styleId], references: [id], onDelete: Cascade)
  choices StyleOptionChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([styleId, label])
  @@index([styleId, position])
  // At most one StyleOption per style may have axisRole SIZE, and at
  // most one may have axisRole FRAMING — enforced in application code
  // (style-options.server.ts), since Postgres partial-unique indexes
  // aren't expressible in Prisma's schema DSL.
}

// One selectable value under a StyleOption. Which fields are
// meaningful depends entirely on the parent option's type/role/
// axisRole (see StyleOption's own comment) — e.g. priceDelta only
// matters when the parent's role is VARIANT, hexColor only when its
// type is COLOR_SWATCH. id is the stable key
// Style.productSettings.sizeVariants matches against on republish, so
// renaming a label later renames the existing Shopify variant instead
// of deleting and recreating it (same reasoning as the old
// StyleSizeOption/StyleFramingOption).
model StyleOptionChoice {
  id String @id @default(cuid())

  optionId String

  label               String
  priceDelta          Decimal?
  compareAtPriceDelta Decimal?
  requiresShipping    Boolean  @default(false)
  scalePercent        Int?
  hexColor            String?
  frameImageAssetId   String?
  borderThicknessPx   Int?
  position            Int      @default(0)

  option          StyleOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  frameImageAsset StyleAsset? @relation(fields: [frameImageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionId, label])
  @@index([optionId, position])
  @@index([frameImageAssetId])
}

// Shopify's standard offline/online session model remains independent from
// merchant-created AI styles. No Shopify product is created when a Style
// record is created. Product creation happens only during Publish.
